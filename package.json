{
  "name": "tandem-webgpu",
  "version": "0.1.0",
  "description": "Tandem8x32 for WebGPU: a pseudorandom number generator fast on CPUs and GPUs alike",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "tandem.wgsl",
    "tandem_f32.wgsl",
    "tandem_derived.wgsl",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/core.test.ts tests/cpu.test.ts",
    "bench:cpu": "node tools/bench_cpu.ts"
  },
  "repository": "github:tandem-rng/tandem-webgpu",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^7"
  }
}
